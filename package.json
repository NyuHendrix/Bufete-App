{
  "name": "auto-buffete",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite frontend --config frontend/vite.config.js",
    "server": "node backend/server.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build frontend --config frontend/vite.config.js",
    "lint": "eslint frontend",
    "preview": "vite preview frontend --config frontend/vite.config.js",
    "db:migrate": "node backend/migrations/run.js",
    "db:seed": "node backend/seeders/seed.js",
    "db:reset": "node -e \"import('./backend/config/db.js').then(async ({ initializeDatabase }) => { await initializeDatabase(true); console.log('reset ok'); })\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tinyhttp/app": "^3.0.11",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "file-saver": "^2.0.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lowdb": "^7.0.1",
    "lucide-react": "^1.45.0",
    "milliparsec": "^5.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sqlite3": "^6.0.1",
    "tailwind": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "json-server": "^1.0.0-beta.3",
    "vite": "^8.3.0"
  }
}
